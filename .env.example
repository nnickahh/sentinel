# =====================================================================
# SENTINEL - AI Privacy Desktop App Configuration
# NVIDIA x Nebius Global AI Hackathon
# =====================================================================

# Nebius Token Factory Credentials
# Get your API key at: https://tokenfactory.nebius.com / https://studio.nebius.ai
NEBIUS_API_KEY=your_nebius_api_key_here

# Nebius Token Factory Endpoint (OpenAI-compatible)
NEBIUS_BASE_URL=https://api.studio.nebius.ai/v1/

# NVIDIA Nemotron Model hosted on Nebius Token Factory
# Options include:
# - nvidia/Llama-3.1-Nemotron-70B-Instruct-HF
# - nvidia/nemotron-4-340b-instruct
# - meta-llama/Meta-Llama-3.1-70B-Instruct
NEBIUS_MODEL=nvidia/Llama-3.1-Nemotron-70B-Instruct-HF

# Sentinel App Configuration
SENTINEL_HOST=127.0.0.1
SENTINEL_PORT=8765

# Out-of-the-box Demo Mode for Hackathon Evaluators
# Set to 'true' to start with realistic simulated network telemetry
# Set to 'false' to monitor live local network connections via psutil
SENTINEL_DEMO_MODE=true

# Request timeout in seconds for Nebius Token Factory API
NEBIUS_TIMEOUT=20
